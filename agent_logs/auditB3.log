# Hermes Universal Gateway — environment configuration example.
# Copy to .env.gateway (or export the variables directly). No secrets:
# leave API keys empty unless you need them.

# --- Server bind (default 127.0.0.1:8787) ---
HERMES_GATEWAY_HOST=127.0.0.1
HERMES_GATEWAY_PORT=8787

# --- Auth ---
# When set, the HTTP surface requires `Authorization: Bearer <key>`.
# When empty, only loopback requests are accepted.
HERMES_GATEWAY_API_KEY=

# --- Rate limit ---
# Per-key token bucket, requests per second. 0 disables limiting.
HERMES_GATEWAY_RATE_LIMIT_RPS=10

# --- Backend selection: auto | hermes | standalone | stub ---
HERMES_GATEWAY_BACKEND=auto

# --- Synthesis LLM (OpenAI-compatible) ---
HERMES_GATEWAY_SYNTH_BASE_URL=https://opencode.ai/zen/go/v1
HERMES_GATEWAY_SYNTH_API_KEY=
HERMES_GATEWAY_SYNTH_MODEL=deepseek-flash
HERMES_GATEWAY_SYNTH_TIMEOUT=120
# Optional extra HTTP headers (JSON object) for the synth client. The OpenCode
# Zen/Go relay requires x-opencode-session; the gateway already adds one
# automatically for opencode.ai targets, so normally nothing goes here.
HERMES_GATEWAY_SYNTH_HEADERS=

# --- Databases ---
HERMES_GATEWAY_CACHE_DB=data/answers.db
HERMES_GATEWAY_STORE_DB=data/searchstore.db

# --- Search caps ---
HERMES_GATEWAY_FAST_MAX_RESULTS=10
HERMES_GATEWAY_FAST_EXTRACT=4
HERMES_GATEWAY_DEEP_SEARCH_QUERIES=3
HERMES_GATEWAY_DEEP_EXTRACT=8

# --- Hermes bridge (used when backend=hermes) ---
HERMES_GATEWAY_HERMES_PYTHON=
HERMES_GATEWAY_HERMES_HOME=
HERMES_GATEWAY_REPO_ROOT=
