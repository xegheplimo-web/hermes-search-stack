# Server-side proxy target. The demo backend is the local Hermes gateway
# (OpenAI-compatible /v1/chat/completions).
# Default: http://127.0.0.1:8787/v1/chat/completions
HERMES_BACKEND_URL=http://127.0.0.1:8787/v1/chat/completions

# Backend protocol flavor:
#   gateway    (default) — local r16 search gateway; SSE passed through as-is.
#   hermes_api — Hermes api_server; the proxy re-frames its named SSE events
#              (hermes.tool.progress / hermes.status) into the client contract
#              and back-fills tool results from the session transcript.
#              Also enables the X-Hermes-Session-Id header (multi-turn memory).
# HERMES_BACKEND_FLAVOR=gateway

# --- Example: Hermes api_server on :8642 ------------------------------------
# HERMES_BACKEND_FLAVOR=hermes_api
# HERMES_BACKEND_URL=http://127.0.0.1:8642/v1/chat/completions
# HERMES_BACKEND_KEY=<api_server key>  # REQUIRED by api_server — server-side
#                                      # only, never NEXT_PUBLIC_*

# Model name sent in the chat-completions request body.
# Default: hermes-search
HERMES_BACKEND_MODEL=hermes-search

# Optional bearer token for the backend. Server-side ONLY — do not prefix
# with NEXT_PUBLIC_. Leave empty to omit the Authorization header entirely.
HERMES_BACKEND_KEY=
